{
  "name": "igor-client-finder",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Поиск автосервисов в открытых данных OSM без рассылок и платных API",
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "scripts": {
    "start": "node --use-env-proxy src/cli.mjs",
    "audit": "node --use-env-proxy scripts/bootstrap-audit.mjs",
    "setup:audit": "node --use-env-proxy scripts/bootstrap-audit.mjs --setup",
    "test": "node scripts/check.mjs --test",
    "check": "node scripts/check.mjs",
    "diagnose:sources": "node --use-env-proxy scripts/diagnose-sources.mjs"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "robots-parser": "3.0.1"
  }
}
